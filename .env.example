POSTGRES_DB=credentials
POSTGRES_USER=credentials
POSTGRES_PASSWORD=credentials_local
# Genera una clave aleatoria local de al menos 32 bytes antes de iniciar.
JWT_SECRET=
# Otra clave aleatoria independiente, 32 bytes codificados en base64. Conservar para restaurar MFA.
MFA_ENCRYPTION_KEY=
# Clave independiente de 32 bytes en base64 para la cola de correos.
MAIL_ENCRYPTION_KEY=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=credentials
GEMINI_API_KEY=
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Identificadores publicos. No cambiar las claves existentes sin conservar las anteriores.
JWT_KEY_ID=legacy
JWT_PREVIOUS_KEYS=
MFA_KEY_ID=legacy
MFA_PREVIOUS_KEYS=
MAIL_KEY_ID=legacy
MAIL_PREVIOUS_KEYS=
SECURITY_RETENTION_DAYS=30
SECURITY_MAINTENANCE_ENABLED=true

# Independent random 32-byte base64 keys. Keep them with private backups.
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_KEY_ID=legacy
EVIDENCE_PREVIOUS_KEYS=
EVIDENCE_RETENTION_DAYS=90
EVIDENCE_CLEANUP_ENABLED=false
SIGNING_ENCRYPTION_KEY=
# Local pilot only. Self-signed test PDFs are visibly marked.
SIGNING_ALLOW_DEMO=false
